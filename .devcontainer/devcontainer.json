{
    "name": "fibo-planner-on-gcp",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "forwardPorts": [8080],
    "runArgs": [
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-docker"
            ]
        }
    },
    "remoteUser": "root"
}